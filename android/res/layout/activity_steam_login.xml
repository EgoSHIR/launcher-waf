<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#181A21">

    <ScrollView
        android:id="@+id/login_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/login_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingLeft="48dp"
                android:paddingRight="48dp">

                <ImageView
                    android:id="@+id/steam_logo"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/ic_steam_logo"
                    android:contentDescription="Steam"
                    android:layout_marginBottom="24dp"/>

                <TextView
                    android:id="@+id/login_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sign in"
                    android:textColor="#FFFFFF"
                    android:textSize="34sp"
                    android:fontFamily="sans-serif-light"
                    android:textStyle="normal"
                    android:letterSpacing="0.04"
                    android:gravity="center"
                    android:layout_marginBottom="32dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Account name"
                    android:textColor="#b8b6b4"
                    android:textSize="14sp"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/input_account"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:background="@drawable/input_field"
                    android:textColor="#E9E9E9"
                    android:textColorHint="#62656D"
                    android:textSize="14sp"
                    android:gravity="center_vertical"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:inputType="textNoSuggestions"
                    android:layout_marginBottom="18dp"/>

                <LinearLayout
                    android:id="@+id/password_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Password"
                    android:textColor="#b8b6b4"
                    android:textSize="14sp"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/input_password"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:background="@drawable/input_field"
                    android:textColor="#E9E9E9"
                    android:textColorHint="#62656D"
                    android:textSize="14sp"
                    android:gravity="center_vertical"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:inputType="textPassword"
                    android:layout_marginBottom="18dp"/>

                <Button
                    android:id="@+id/btn_sign_in"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:background="@drawable/btn_steam_primary_selector"
                    android:text="SIGN IN"
                    android:textColor="#c3e1f8"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:shadowColor="#000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="2"
                    android:layout_marginBottom="6dp"/>

                <Button
                    android:id="@+id/btn_approve_phone"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:background="@drawable/btn_steam_secondary_selector"
                    android:text="APPROVE ON PHONE"
                    android:textColor="#b8b6b4"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:shadowColor="#000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="2"
                    android:layout_marginBottom="10dp"/>

                </LinearLayout>

                <CheckBox
                    android:id="@+id/chk_material_you"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Material You"
                    android:textColor="#62656D"
                    android:textSize="11sp"
                    android:buttonTint="#62656D"/>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingLeft="48dp"
                android:paddingRight="48dp"
                android:paddingBottom="32dp"
                android:paddingTop="24dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#264959"
                    android:layout_marginBottom="24dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="New to Steam?"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="14dp"/>

                <Button
                    android:id="@+id/btn_create_account"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:background="@drawable/btn_steam_primary_selector"
                    android:text="CREATE AN ACCOUNT"
                    android:textColor="#c3e1f8"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:shadowColor="#000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="2"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="It's free and easy. Discover thousands of games to play with millions of new friends."
                    android:textColor="#b8b6b4"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"/>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <ScrollView
        android:id="@+id/profile_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/profile_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingLeft="40dp"
                android:paddingRight="40dp"
                android:paddingTop="32dp"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:background="#1F2933"
                    android:padding="32dp"
                    android:layout_marginBottom="20dp">

                    <FrameLayout
                        android:layout_width="104dp"
                        android:layout_height="104dp"
                        android:layout_marginBottom="16dp">

                        <ImageView
                            android:id="@+id/profile_avatar_border"
                            android:layout_width="104dp"
                            android:layout_height="104dp"
                            android:scaleType="fitXY"
                            android:src="@drawable/avatar_border"/>

                        <ImageView
                            android:id="@+id/profile_avatar"
                            android:layout_width="94dp"
                            android:layout_height="94dp"
                            android:layout_gravity="center"
                            android:scaleType="centerCrop"
                            android:contentDescription="Avatar"
                            android:src="@drawable/ic_launcher"/>

                    </FrameLayout>

                    <TextView
                        android:id="@+id/profile_persona_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Online"
                        android:textColor="#5BA37D"
                        android:textSize="12sp"
                        android:layout_marginBottom="16dp"/>

                    <View
                        android:layout_width="140dp"
                        android:layout_height="1dp"
                        android:background="#264959"
                        android:layout_marginBottom="14dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="STEAM ID"
                        android:textColor="#5A6A7A"
                        android:textSize="10sp"
                        android:letterSpacing="0.08"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/profile_steam_id"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#8F98A0"
                        android:textSize="12sp"
                        android:fontFamily="monospace"/>

                </LinearLayout>

                <Button
                    android:id="@+id/btn_view_profile"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:background="@drawable/btn_steam_primary_selector"
                    android:text="VIEW MY PROFILE"
                    android:textColor="#c3e1f8"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:shadowColor="#000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="2"
                    android:layout_marginBottom="10dp"/>

                <Button
                    android:id="@+id/btn_logout"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:background="@drawable/btn_steam_secondary_selector"
                    android:text="SIGN OUT"
                    android:textColor="#b8b6b4"
                    android:textSize="12sp"
                    android:textStyle="bold"/>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <FrameLayout
        android:id="@+id/loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC181A21"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/loading_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_steam_logo"
                android:layout_marginBottom="20dp"/>

            <TextView
                android:id="@+id/status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#b8b6b4"
                android:textSize="14sp"/>

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
