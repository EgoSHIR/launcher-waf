<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:startColor="#2A475E"
                android:endColor="#1B2838"
                android:angle="45"/>
            <size android:width="96dp" android:height="96dp"/>
        </shape>
    </item>
    <item android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#171D25"/>
            <size android:width="52dp" android:height="52dp"/>
        </shape>
    </item>
    <item android:gravity="center">
        <rotate android:fromDegrees="25">
            <shape android:shape="oval">
                <solid android:color="#66C0F4"/>
                <size android:width="32dp" android:height="40dp"/>
            </shape>
        </rotate>
    </item>
    <item android:gravity="center|bottom" android:bottom="14dp">
        <shape android:shape="oval">
            <solid android:color="#66C0F4"/>
            <size android:width="14dp" android:height="14dp"/>
        </shape>
    </item>
</layer-list>
